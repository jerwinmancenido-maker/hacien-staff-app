# Copy to .env and fill in. Never commit .env.

# MySQL 8 connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hacien"

# Long random string (e.g. `openssl rand -hex 32`). Used to sign session tokens.
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the app, used in password reset / invite links
APP_URL="http://localhost:3000"

# Outgoing mail. Leave SMTP_HOST empty in development to print links to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HACIEN Staff <no-reply@example.com>"

# How many reverse proxies in front of the app append to X-Forwarded-For (default 1).
# The client IP is taken that many entries from the right; 0 ignores the header.
TRUSTED_PROXY_COUNT="1"

# Optional: a separate MySQL database for the database test suites (tests/db).
# Its name must contain "test". Migrations are applied to it automatically.
# TEST_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/hacien_test

# Uploaded business documents (DTI, SEC, BIR 2303 …). Must be OUTSIDE the app
# directory and never under public/ or .next/ (deploys replace the app dir).
# Hostinger example: /home/<user>/hacien-uploads/staging. Defaults to ./.uploads.
# UPLOAD_DIR="/home/USER/hacien-uploads/ENV"
# Max upload size in MB (default 10).
# UPLOAD_MAX_MB="10"

# Part 6 Payables (supplier payments). OFF by default.
# Prefer Settings → Features → Enable Payables for staging.
# If set, this env overrides the Settings flag (true/false/1/0).
# PAYABLES_ENABLED="true"

# Part 7a Cash (accounts, expenses, transfers). OFF by default.
# Prefer Settings → Features → Enable Cash for staging.
# If set, this env overrides the Settings flag (true/false/1/0).
# CASH_ENABLED="true"

# Payables: issue BIR 2307 to suppliers (withholding agent). OFF by default.
# HACIEN is not a withholding agent until RDO confirms. Requires Payables on.
# Prefer Settings → Features, or set PAYABLES_2307_ENABLED=true.
# PAYABLES_2307_ENABLED="true"

# Part 7b Books (read-only registers / export). OFF by default.
# Prefer Settings → Features → Enable Books for staging.
# If set, this env overrides the Settings flag (true/false/1/0).
# BOOKS_ENABLED="true"
