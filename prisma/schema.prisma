// HACIEN Staff App — Prisma schema (MySQL 8)
//
// Rules that shape this schema:
// - Nothing is ever hard-deleted. Master data uses `active` + `archivedAt`;
//   documents (later) will use `voidedAt` + `voidReason`. The Prisma client
//   is extended to throw on delete/deleteMany (src/lib/no-delete.ts).
// - Every change writes an AuditLog row in the same transaction.
// - Settings are versioned: each save is a new SettingsVersion row holding the
//   full settings snapshot. Future documents store `settingsVersionId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, roles, sessions
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(120)
  // Null until the user sets a password from their invite link.
  passwordHash String?   @db.VarChar(100)
  // Roles (a user may hold several, e.g. Admin + Approver). Stored as flags so
  // removing a role is an update, never a delete.
  isAdmin      Boolean   @default(false)
  isApprover   Boolean   @default(false)
  isStaff      Boolean   @default(false)
  isViewer     Boolean   @default(false)
  canSeeCosts  Boolean   @default(false)
  // Turned-off users cannot sign in; they are never deleted.
  active       Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  settingsSaves SettingsVersion[]

  quotesCreated      Quote[]            @relation("QuoteCreatedBy")
  quotesUpdated      Quote[]            @relation("QuoteUpdatedBy")
  salesOrdersCreated SalesOrder[]       @relation("SalesOrderCreatedBy")
  salesOrdersUpdated SalesOrder[]       @relation("SalesOrderUpdatedBy")
  voids              DocumentVoid[]
  documentsUploaded  BusinessDocument[]

  purchaseOrdersCreated  PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated  PurchaseOrder[]      @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersApproved PurchaseOrder[]      @relation("PurchaseOrderApprovedBy")
  receivingReportsBy     ReceivingReport[]    @relation("ReceivingReportReceivedBy")
  receivingReportsMade   ReceivingReport[]    @relation("ReceivingReportCreatedBy")
  supplierBillsCreated   SupplierBill[]
  attachmentsUploaded    DocumentAttachment[]
  billingsCreated        Billing[]            @relation("BillingCreatedBy")
  billingsUpdated        Billing[]            @relation("BillingUpdatedBy")
  collectionsCreated     Collection[]         @relation("CollectionCreatedBy")
}

model Session {
  id        String    @id @default(cuid())
  // HMAC-SHA256 of the cookie token (the raw token is never stored).
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
  // Sign out / user turned off: sessions are revoked, not deleted.
  revokedAt DateTime?
  ip        String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(255)

  @@index([userId])
}

enum TokenPurpose {
  RESET
  INVITE
}

model PasswordResetToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique @db.VarChar(64)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  purpose   TokenPurpose
  createdAt DateTime     @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(191)
  ip        String   @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  // Per-email failure cap (any IP).
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Settings (versioned)
// ---------------------------------------------------------------------------

model SettingsVersion {
  id            String   @id @default(cuid())
  // 1, 2, 3 … increasing. Shown in the change log.
  version       Int      @unique
  // Full settings snapshot (see src/lib/settings/schema.ts).
  data          Json
  // Which section changed in this version (null for the seed version).
  changedKey    String?  @db.VarChar(64)
  before        Json?
  after         Json?
  effectiveFrom DateTime @default(now())
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
}

// ---------------------------------------------------------------------------
// Companies and contacts
// ---------------------------------------------------------------------------

enum WithholdingType {
  GOVERNMENT
  TOP_WITHHOLDING_AGENT
  NONE
}

enum SupplierTaxType {
  VAT
  NON_VAT
  NO_RECEIPT
}

model Customer {
  id                 String          @id @default(cuid())
  name               String          @db.VarChar(191)
  // Normalized 000-000-000-000 (branch code defaults to 000). Unique among customers.
  tin                String?         @unique @db.VarChar(20)
  // DEPRECATED (kept for one release, then dropped): the old free-text address.
  // Copied into a default BILLING Address by migration 20261030120000. Use Address.
  address            String?         @db.Text
  withholdingType    WithholdingType
  // Default withholding for new quotes: a JSON array of WithholdingRate codes
  // (e.g. ["GOODS_1","GOV_PT_3"]). Null or [] means none.
  defaultWithholding Json?
  defaultTerms       String?         @db.VarChar(100)
  notes              String?         @db.Text
  active             Boolean         @default(true)
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  contacts     Contact[]
  quotes       Quote[]
  salesOrders  SalesOrder[]
  addresses    Address[]
  documents    BusinessDocument[]
  billings     Billing[]
  collections  Collection[]
  withholdings Withholding2307[]

  @@index([name])
}

model Supplier {
  id                String          @id @default(cuid())
  name              String          @db.VarChar(191)
  // Normalized like customer TINs. Unique among suppliers.
  tin               String?         @unique @db.VarChar(20)
  // DEPRECATED (kept for one release, then dropped). Use Address.
  address           String?         @db.Text
  taxType           SupplierTaxType
  defaultTerms      String?         @db.VarChar(100)
  // UnionBank details used when paying this supplier.
  bankAccountName   String?         @db.VarChar(191)
  bankAccountNumber String?         @db.VarChar(64)
  bankBranch        String?         @db.VarChar(191)
  bankNotes         String?         @db.Text
  notes             String?         @db.Text
  active            Boolean         @default(true)
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  contacts        Contact[]
  quoteItems      QuoteItem[]
  salesOrderItems SalesOrderItem[]
  addresses       Address[]
  documents       BusinessDocument[]
  purchaseOrders  PurchaseOrder[]
  supplierBills   SupplierBill[]

  @@index([name])
}

// A contact belongs to exactly one customer OR one supplier.
model Contact {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  name       String    @db.VarChar(191)
  role       String?   @db.VarChar(100)
  email      String?   @db.VarChar(191)
  phone      String?   @db.VarChar(64)
  isMain     Boolean   @default(false)
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  quotes         Quote[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([customerId])
  @@index([supplierId])
}

// Structured Philippine address. Belongs to exactly one customer OR one
// supplier (checked in src/lib/services/addresses.ts). Many per owner; at most
// one active default per owner and kind. Archived, never deleted.
enum AddressKind {
  BILLING
  DELIVERY
  OFFICE
  WAREHOUSE
  OTHER
}

model Address {
  id               String      @id @default(cuid())
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  kind             AddressKind
  label            String?     @db.VarChar(100)
  // Unit / building / street
  street           String      @db.Text
  barangay         String      @default("") @db.VarChar(120)
  cityMunicipality String      @default("") @db.VarChar(120)
  province         String      @default("") @db.VarChar(120)
  // 4 digits (blank only on addresses copied from the old free-text field)
  zip              String      @default("") @db.VarChar(4)
  isDefault        Boolean     @default(false)
  // Copied from the old free-text address: someone should split it into fields.
  needsReview      Boolean     @default(false)
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([customerId])
  @@index([supplierId])
}

// ---------------------------------------------------------------------------
// Business documents (DTI, SEC, BIR 2303, permits …): uploaded files
// ---------------------------------------------------------------------------

enum BusinessDocumentType {
  DTI
  SEC
  CDA
  BIR_2303
  MAYORS_PERMIT
  PHILGEPS
  BARANGAY_CLEARANCE
  TAX_CLEARANCE
  OTHER
}

// The file lives on disk under UPLOAD_DIR (outside the web root) as
// `storageKey`, a random key; the user's file name is only metadata. Replacing a
// document uploads a new one and archives the old (`replacesId` links them).
model BusinessDocument {
  id           String               @id @default(cuid())
  customerId   String?
  customer     Customer?            @relation(fields: [customerId], references: [id])
  supplierId   String?
  supplier     Supplier?            @relation(fields: [supplierId], references: [id])
  type         BusinessDocumentType
  otherLabel   String?              @db.VarChar(100)
  docNumber    String?              @db.VarChar(100)
  issueDate    DateTime?            @db.Date
  expiryDate   DateTime?            @db.Date
  fileName     String               @db.VarChar(255)
  mimeType     String               @db.VarChar(100)
  sizeBytes    Int
  storageKey   String               @unique @db.VarChar(64)
  sha256       String               @db.VarChar(64)
  replacesId   String?              @db.VarChar(64)
  uploadedById String
  uploadedBy   User                 @relation(fields: [uploadedById], references: [id])
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([customerId])
  @@index([supplierId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditAction {
  create
  update
  archive
  restore
  void
  login
  login_failed
  settings_change
  email_draft
  download
}

model AuditLog {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  entityType String      @db.VarChar(40)
  entityId   String?     @db.VarChar(64)
  action     AuditAction
  // Only the changed fields: { field: value } before and after.
  before     Json?
  after      Json?
  ip         String?     @db.VarChar(64)

  @@index([entityType, entityId])
  @@index([at])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Withholding rates (Settings → Withholding)
// ---------------------------------------------------------------------------

// Which quote lines a rate applies to: goods lines, services lines, or (for the
// government percentage tax / VAT withholding) the whole contract price.
enum WithholdingLineKind {
  GOODS
  SERVICES
  GOV_PT
  GOV_VAT
}

// Editable table. Every save also writes a SettingsVersion (changedKey
// "withholding") and an AuditLog row, like the other settings. Rows are never
// deleted; turn one off with `active`. Quotes snapshot the values they use.
model WithholdingRate {
  id        String              @id @default(cuid())
  // Stable key used by customer defaults and quote snapshots, e.g. GOODS_1.
  code      String              @unique @db.VarChar(32)
  label     String              @db.VarChar(100)
  lineKind  WithholdingLineKind
  atcCode   String?             @db.VarChar(20)
  // Fraction, e.g. 0.0100 = 1%.
  rate      Decimal             @db.Decimal(5, 4)
  active    Boolean             @default(true)
  note      String?             @db.VarChar(255)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

enum DocType {
  QUOTE
  SALES_ORDER
  PURCHASE_ORDER
  RECEIVING_REPORT
  SUPPLIER_BILL
  BILLING
  COLLECTION
}

// One counter per document type per year (year 0 = a counter that never resets).
// Numbers are allocated with SELECT … FOR UPDATE on this row inside the same
// transaction that creates the document, so a failed create rolls the counter
// back with it. Numbers are never reused: voided documents keep theirs.
model DocumentSeries {
  id         String  @id @default(cuid())
  docType    DocType
  year       Int
  prefix     String  @db.VarChar(10)
  nextNumber Int     @default(1)
  padding    Int     @default(4)

  @@unique([docType, year])
}

// Written in the same transaction that voids a document. `snapshot` is the
// document (header + items) as it was just before the void.
model DocumentVoid {
  id         String   @id @default(cuid())
  docType    DocType
  docNumber  String   @db.VarChar(40)
  docId      String   @db.VarChar(64)
  reason     String   @db.Text
  snapshot   Json
  voidedById String
  voidedBy   User     @relation(fields: [voidedById], references: [id])
  voidedAt   DateTime @default(now())

  @@index([docType, docId])
}

// ---------------------------------------------------------------------------
// Quotes and sales orders
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  WON
  LOST
  VOID
}

enum SalesOrderStatus {
  OPEN
  VOID
}

enum ItemKind {
  GOODS
  SERVICES
}

// Money is Decimal(15,2) pesos. Line and document totals are computed on the
// server (src/lib/quotes/calc.ts) and stored. `withholding` is a snapshot of the
// selected WithholdingRate rows ([{ code, label, lineKind, rate, atcCode }]), so
// later Settings edits never change an existing quote.
model Quote {
  id                String      @id @default(cuid())
  number            String      @unique @db.VarChar(40)
  revision          Int         @default(1)
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  contactId         String?
  contact           Contact?    @relation(fields: [contactId], references: [id])
  date              DateTime    @db.Date
  validUntil        DateTime    @db.Date
  status            QuoteStatus @default(DRAFT)
  terms             String?     @db.VarChar(100)
  notes             String?     @db.Text
  settingsVersionId String
  withholding       Json

  contractPrice    Decimal @default(0) @db.Decimal(15, 2)
  withholdingTotal Decimal @default(0) @db.Decimal(15, 2)
  netReceived      Decimal @default(0) @db.Decimal(15, 2)
  supplierCost     Decimal @default(0) @db.Decimal(15, 2)
  netMargin        Decimal @default(0) @db.Decimal(15, 2)
  // Net margin as % of the contract price, 2 dp.
  netMarginPct     Decimal @default(0) @db.Decimal(7, 2)

  voidedAt    DateTime?
  voidReason  String?   @db.Text
  createdById String
  createdBy   User      @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User      @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       QuoteItem[]
  salesOrders SalesOrder[]

  @@index([customerId])
  @@index([status])
  @@index([date])
}

// Items are never deleted: a line removed in the editor gets `removedAt`.
model QuoteItem {
  id               String    @id @default(cuid())
  quoteId          String
  quote            Quote     @relation(fields: [quoteId], references: [id])
  sortOrder        Int
  description      String    @db.Text
  kind             ItemKind
  qty              Decimal   @db.Decimal(12, 2)
  unit             String    @db.VarChar(30)
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  supplierUnitCost Decimal   @default(0) @db.Decimal(15, 2)
  // HACIEN (buyer-facing) unit price.
  unitPrice        Decimal   @db.Decimal(15, 2)
  // qty × unitPrice
  total            Decimal   @db.Decimal(15, 2)
  // supplierUnitCost × buyer qty
  supplierTotal    Decimal   @default(0) @db.Decimal(15, 2)
  // total − supplierTotal
  margin           Decimal   @default(0) @db.Decimal(15, 2)
  removedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([quoteId])
}

// Created only by converting a quote. Copies the quote's header, items (with
// costs), withholding snapshot and settings version.
model SalesOrder {
  id                String           @id @default(cuid())
  number            String           @unique @db.VarChar(40)
  quoteId           String
  quote             Quote            @relation(fields: [quoteId], references: [id])
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id])
  date              DateTime         @db.Date
  status            SalesOrderStatus @default(OPEN)
  buyerPoNo         String?          @db.VarChar(64)
  buyerPoDate       DateTime?        @db.Date
  deliveryAddress   String?          @db.Text
  terms             String?          @db.VarChar(100)
  notes             String?          @db.Text
  settingsVersionId String
  withholding       Json

  contractPrice    Decimal @default(0) @db.Decimal(15, 2)
  withholdingTotal Decimal @default(0) @db.Decimal(15, 2)
  netReceived      Decimal @default(0) @db.Decimal(15, 2)
  supplierCost     Decimal @default(0) @db.Decimal(15, 2)
  netMargin        Decimal @default(0) @db.Decimal(15, 2)
  netMarginPct     Decimal @default(0) @db.Decimal(7, 2)

  voidedAt    DateTime?
  voidReason  String?   @db.Text
  createdById String
  createdBy   User      @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User      @relation("SalesOrderUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items          SalesOrderItem[]
  purchaseOrders PurchaseOrder[]
  billings       Billing[]

  @@index([quoteId])
  @@index([customerId])
  @@index([status])
  @@index([date])
}

model SalesOrderItem {
  id               String     @id @default(cuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id])
  sortOrder        Int
  description      String     @db.Text
  kind             ItemKind
  qty              Decimal    @db.Decimal(12, 2)
  unit             String     @db.VarChar(30)
  supplierId       String?
  supplier         Supplier?  @relation(fields: [supplierId], references: [id])
  supplierUnitCost Decimal    @default(0) @db.Decimal(15, 2)
  unitPrice        Decimal    @db.Decimal(15, 2)
  total            Decimal    @db.Decimal(15, 2)
  supplierTotal    Decimal    @default(0) @db.Decimal(15, 2)
  margin           Decimal    @default(0) @db.Decimal(15, 2)
  removedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  purchaseOrderItems PurchaseOrderItem[]

  @@index([salesOrderId])
}

// ---------------------------------------------------------------------------
// Supplier purchase orders, receiving reports, supplier bills (3-way match)
// ---------------------------------------------------------------------------

// DRAFT → APPROVED → SENT → PARTIALLY_RECEIVED / RECEIVED (set by receiving
// reports) → CLOSED. VOID (with reason) only before anything is received.
// The rules live in src/lib/purchasing/status.ts.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  VOID
}

enum ReceivingReportStatus {
  POSTED
  VOID
}

enum SupplierBillStatus {
  RECORDED
  VOID
}

// One PO per supplier. Made from a sales order (salesOrderId set; lines link to
// SO lines) or standalone. Unit costs, totals and the supplier are cost data:
// only users with "Can see costs" open PO pages (src/lib/purchasing/views.ts).
model PurchaseOrder {
  id                  String              @id @default(cuid())
  number              String              @unique @db.VarChar(40)
  // Bumped when an approved PO is edited (it goes back to Draft).
  revision            Int                 @default(1)
  status              PurchaseOrderStatus @default(DRAFT)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  supplierContactId   String?
  supplierContact     Contact?            @relation(fields: [supplierContactId], references: [id])
  // Null = standalone PO.
  salesOrderId        String?
  salesOrder          SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  date                DateTime            @db.Date
  expectedDate        DateTime?           @db.Date
  terms               String?             @db.VarChar(100)
  // Snapshots of the text at the time; later address edits don't change the PO.
  deliveryAddressText String?             @db.Text
  deliveryAddressId   String?
  deliveryAddress     Address?            @relation(fields: [deliveryAddressId], references: [id])
  supplierAddressText String?             @db.Text
  notes               String?             @db.Text
  // Company details on the printed PO come from this settings version.
  settingsVersionId   String
  // Sum of line totals (qty × unit cost).
  subtotal            Decimal             @default(0) @db.Decimal(15, 2)

  approvedById String?
  approvedBy   User?     @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  sentAt       DateTime?
  closedAt     DateTime?
  closeReason  String?   @db.Text
  voidedAt     DateTime?
  voidReason   String?   @db.Text
  createdById  String
  createdBy    User      @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  updatedById  String
  updatedBy    User      @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items            PurchaseOrderItem[]
  receivingReports ReceivingReport[]
  bills            SupplierBill[]

  @@index([supplierId])
  @@index([salesOrderId])
  @@index([status])
  @@index([date])
  @@index([expectedDate])
}

// Items are never deleted: a line removed in the editor gets `removedAt`.
model PurchaseOrderItem {
  id                     String          @id @default(cuid())
  purchaseOrderId        String
  purchaseOrder          PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  salesOrderItemId       String?
  salesOrderItem         SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  // = salesOrderItemId while the line is live on a non-void PO, else NULL.
  // Unique, so a sales order line is bought on one PO at a time (MySQL has no
  // partial unique index; NULLs don't collide). Cleared when the PO is voided
  // or the line removed, which frees the SO line for a new PO.
  activeSalesOrderItemId String?         @unique @db.VarChar(191)
  sortOrder              Int
  description            String          @db.Text
  kind                   ItemKind
  qty                    Decimal         @db.Decimal(12, 2)
  unit                   String          @db.VarChar(30)
  unitCost               Decimal         @db.Decimal(15, 2)
  // qty × unitCost
  total                  Decimal         @db.Decimal(15, 2)
  // Sum of posted receiving report lines. Updated in the same transaction as
  // the RR (post or void), with the PO lines locked FOR UPDATE.
  receivedQty            Decimal         @default(0) @db.Decimal(12, 2)
  removedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  receivingItems ReceivingReportItem[]
  billItems      SupplierBillItem[]

  @@index([purchaseOrderId])
  @@index([salesOrderItemId])
}

// RR-YYYY-####. Quantities only (no prices), so staff without cost access can
// receive goods. Voiding reverses the quantities.
model ReceivingReport {
  id              String                @id @default(cuid())
  number          String                @unique @db.VarChar(40)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime              @db.Date
  receivedById    String
  receivedBy      User                  @relation("ReceivingReportReceivedBy", fields: [receivedById], references: [id])
  // Supplier's delivery receipt (DR) number.
  deliveryRef     String?               @db.VarChar(64)
  notes           String?               @db.Text
  status          ReceivingReportStatus @default(POSTED)
  voidedAt        DateTime?
  voidReason      String?               @db.Text
  createdById     String
  createdBy       User                  @relation("ReceivingReportCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items       ReceivingReportItem[]
  attachments DocumentAttachment[]

  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
}

model ReceivingReportItem {
  id                  String            @id @default(cuid())
  receivingReportId   String
  receivingReport     ReceivingReport   @relation(fields: [receivingReportId], references: [id])
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  qtyReceived         Decimal           @db.Decimal(12, 2)
  note                String?           @db.VarChar(255)

  @@index([receivingReportId])
  @@index([purchaseOrderItemId])
}

// The supplier's invoice, recorded against a PO (or just the supplier).
// Payments come later.
model SupplierBill {
  id              String             @id @default(cuid())
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  // The supplier's own invoice number.
  billNumber      String             @db.VarChar(64)
  // "<supplierId>:<lower-cased bill no.>" while not void, else NULL: makes the
  // bill number unique per supplier among non-void bills.
  activeKey       String?            @unique @db.VarChar(255)
  billDate        DateTime           @db.Date
  amount          Decimal            @db.Decimal(15, 2)
  notes           String?            @db.Text
  status          SupplierBillStatus @default(RECORDED)
  voidedAt        DateTime?
  voidReason      String?            @db.Text
  createdById     String
  createdBy       User               @relation(fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items       SupplierBillItem[]
  attachments DocumentAttachment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([billDate])
}

// Optional line-level detail of a bill, for the 3-way match.
model SupplierBillItem {
  id                  String            @id @default(cuid())
  supplierBillId      String
  supplierBill        SupplierBill      @relation(fields: [supplierBillId], references: [id])
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  qty                 Decimal           @db.Decimal(12, 2)
  unitPrice           Decimal           @db.Decimal(15, 2)
  // qty × unitPrice
  total               Decimal           @db.Decimal(15, 2)

  @@index([supplierBillId])
  @@index([purchaseOrderItemId])
}

// Files attached to a receiving report (delivery receipt photo), a supplier
// bill (invoice scan), a billing (filled-in booklet copy), a collection, or a
// BIR 2307. Same storage as business documents: random key under UPLOAD_DIR,
// magic-byte sniffed, never deleted (archivedAt instead).
model DocumentAttachment {
  id                String           @id @default(cuid())
  receivingReportId String?
  receivingReport   ReceivingReport? @relation(fields: [receivingReportId], references: [id])
  supplierBillId    String?
  supplierBill      SupplierBill?    @relation(fields: [supplierBillId], references: [id])
  billingId         String?
  billing           Billing?         @relation(fields: [billingId], references: [id])
  collectionId      String?
  collection        Collection?      @relation(fields: [collectionId], references: [id])
  withholding2307Id String?
  withholding2307   Withholding2307? @relation(fields: [withholding2307Id], references: [id])
  fileName          String           @db.VarChar(255)
  mimeType          String           @db.VarChar(100)
  sizeBytes         Int
  storageKey        String           @unique @db.VarChar(64)
  sha256            String           @db.VarChar(64)
  uploadedById      String
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([receivingReportId])
  @@index([supplierBillId])
  @@index([billingId])
  @@index([collectionId])
  @@index([withholding2307Id])
}

// ---------------------------------------------------------------------------
// Customer billing & collections (records of pre-printed booklet invoices;
// the app never generates official invoices or official receipts)
// ---------------------------------------------------------------------------

// Derived from posted CollectionAllocation rows; stored for querying.
enum BillingStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum CollectionStatus {
  POSTED
  VOID
}

enum CollectionMethod {
  CASH
  CHECK
  BANK_TRANSFER
  GCASH
}

enum Withholding2307Status {
  PENDING
  RECEIVED
}

// Internal BL-YYYY-####. `invoiceNo` is the hand-written booklet number (unique
// forever — voided numbers are never reused). Status is recomputed from posted
// allocations whenever a collection is posted or voided.
model Billing {
  id                   String        @id @default(cuid())
  number               String        @unique @db.VarChar(40)
  salesOrderId         String
  salesOrder           SalesOrder    @relation(fields: [salesOrderId], references: [id])
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  // Hand-written booklet invoice number. Unique among all billings (incl. void).
  invoiceNo            Int
  invoiceDate          DateTime      @db.Date
  dueDate              DateTime      @db.Date
  // Gross billed (≤ SO remaining to bill).
  amount               Decimal       @db.Decimal(15, 2)
  // Pro-rata of SO.withholdingTotal for this billing amount.
  withholdingExpected  Decimal       @default(0) @db.Decimal(15, 2)
  // amount − withholdingExpected.
  netExpected          Decimal       @db.Decimal(15, 2)
  status               BillingStatus @default(OPEN)
  notes                String?       @db.Text
  voidedAt             DateTime?
  voidReason           String?       @db.Text
  createdById          String
  createdBy            User          @relation("BillingCreatedBy", fields: [createdById], references: [id])
  updatedById          String
  updatedBy            User          @relation("BillingUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  allocations  CollectionAllocation[]
  withholdings Withholding2307[]
  attachments  DocumentAttachment[]

  @@unique([invoiceNo])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNo])
  @@index([invoiceDate])
}

// Internal CR-YYYY-####. A payment (or advance/downpayment) from a customer.
// `amountReceived` may exceed allocated cash (unapplied = customer credit).
// Allocations to billings are optional at create time and can be applied later.
model Collection {
  id             String             @id @default(cuid())
  number         String             @unique @db.VarChar(40)
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  date           DateTime           @db.Date
  method         CollectionMethod
  reference      String?            @db.VarChar(100)
  checkBank      String?            @db.VarChar(100)
  checkDate      DateTime?          @db.Date
  // Hand-written OR / acknowledgment receipt number (manual text).
  receiptNo      String?            @db.VarChar(64)
  amountReceived Decimal            @db.Decimal(15, 2)
  notes          String?            @db.Text
  status         CollectionStatus   @default(POSTED)
  voidedAt       DateTime?
  voidReason     String?            @db.Text
  createdById    String
  createdBy      User               @relation("CollectionCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  allocations  CollectionAllocation[]
  withholdings Withholding2307[]
  attachments  DocumentAttachment[]

  @@index([customerId])
  @@index([status])
  @@index([date])
}

// Links cash (and optional 2307 withholding) from a collection onto a billing.
// Sum of cashApplied across a collection's allocations ≤ amountReceived
// (remainder is unapplied customer credit). Per billing, cash + withholding
// applied ≤ billing.amount.
model CollectionAllocation {
  id                 String     @id @default(cuid())
  collectionId       String
  collection         Collection @relation(fields: [collectionId], references: [id])
  billingId          String
  billing            Billing    @relation(fields: [billingId], references: [id])
  cashApplied        Decimal    @db.Decimal(15, 2)
  withholdingApplied Decimal    @default(0) @db.Decimal(15, 2)

  @@unique([collectionId, billingId])
  @@index([collectionId])
  @@index([billingId])
}

// BIR Form 2307 (Certificate of Creditable Tax Withheld at Source). Created when
// a collection applies withholding to a billing; PENDING until marked received
// with date + attachment (PDF/JPG/PNG).
model Withholding2307 {
  id           String                @id @default(cuid())
  billingId    String?
  billing      Billing?              @relation(fields: [billingId], references: [id])
  collectionId String?
  collection   Collection?           @relation(fields: [collectionId], references: [id])
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id])
  // Fraction, e.g. 0.0100 = 1%. Prefill from SO withholding snapshot; editable.
  rate         Decimal               @db.Decimal(5, 4)
  atcCode      String?               @db.VarChar(20)
  amount       Decimal               @db.Decimal(15, 2)
  periodFrom   DateTime?             @db.Date
  periodTo     DateTime?             @db.Date
  status       Withholding2307Status @default(PENDING)
  receivedAt   DateTime?             @db.Date
  notes        String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  attachments DocumentAttachment[]

  @@index([customerId])
  @@index([billingId])
  @@index([collectionId])
  @@index([status])
}
